## ============================================================================
## TravelScope - 智能旅游助手 环境变量配置
## ============================================================================
## 使用说明：
##   1. 复制本文件为 .env（或直接在系统环境变量 / IDE 高级设置中配置）
##   2. 填入你的真实 API Key
##   3. 切勿将 .env 提交到 Git（已在 .gitignore 中忽略）
## ============================================================================

# 通义千问（DashScope）API Key
# 获取地址: https://dashscope.console.aliyun.com/apiKey
API_KEY=your_dashscope_api_key_here

# 高德地图 Web API Key
# 获取地址: https://lbs.amap.com/api/javascriptapi-v2/guide/abc/prepare
AMAP_WEB_API_KEY=your_amap_web_api_key_here

# 和风天气 API Host（不含 https:// 前缀！）
# 获取地址: https://dev.qweather.com/
# 免费开发版: devapi.qweather.com
# 标准订阅版: api.qweather.com
# 用户专属域名: xxx.re.qweatherapi.com（控制台查看）
WEATHER_API_HOST=devapi.qweather.com

# 和风天气 API Key
WEATHER_API_KEY=your_qweather_api_key_here
